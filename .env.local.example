# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# Get this from https://resend.com/api-keys after creating an account
RESEND_API_KEY=

# Where contact form submissions get sent.
# Until everlineplumbing.ca is verified as a sending domain in Resend,
# this MUST be the same email address you signed up to Resend with —
# Resend's sandbox mode only allows delivery to your own account email.
CONTACT_EMAIL=

# Google Places API — used to pull real Google reviews into Testimonials.
# Get an API key at console.cloud.google.com (enable "Places API (New)"),
# and find your Place ID at developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
